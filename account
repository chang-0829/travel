<!-- 
    頁面專屬的腳本 
    注意：因為是由 index.html 動態載入，這些腳本會在載入時被執行。
    為了避免重複綁定事件或污染全域變數，建議使用 IIFE (立即執行函式) 包覆。
-->
<script>
    (function() {
        // --- UI 元素 ---
        const unauthView = document.getElementById('unauth-view');
        const authView = document.getElementById('auth-view');
        const btnLoginGoogle = document.getElementById('btn-login-google');
        const btnLoginEmail = document.getElementById('btn-login-email');
        const btnLogout = document.getElementById('btn-logout');
        
        const userNameEl = document.getElementById('user-name');
        const userEmailEl = document.getElementById('user-email');
        const userAvatarEl = document.getElementById('user-avatar');

        // --- 狀態切換函數 (UI 展示用) ---
        function showAuthView(user) {
            unauthView.classList.add('hidden');
            authView.classList.remove('hidden');
            
            // 填入假資料 (未來替換為 Firebase User 資料)
            userNameEl.textContent = user.name || '旅人';
            userEmailEl.textContent = user.email || '';
            if (user.photoURL) {
                userAvatarEl.src = user.photoURL;
            }
        }

        function showUnauthView() {
            unauthView.classList.remove('hidden');
            authView.classList.add('hidden');
        }

        // --- 模擬登入流程 (供您檢視 UI 效果) ---
        // 🚨 之後這裡要換成呼叫 Firebase 的 signInWithPopup 🚨
        btnLoginGoogle.addEventListener('click', () => {
            // 模擬載入狀態
            const originalText = btnLoginGoogle.innerHTML;
            btnLoginGoogle.innerHTML = '<svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> 登入中...';
            btnLoginGoogle.disabled = true;

            setTimeout(() => {
                // 模擬登入成功，取得使用者資料
                const mockUser = {
                    name: '探險家小明',
                    email: 'explorer@example.com',
                    photoURL: 'https://ui-avatars.com/api/?name=明&background=0D8ABC&color=fff&size=128'
                };
                showAuthView(mockUser);
                
                // 恢復按鈕狀態
                btnLoginGoogle.innerHTML = originalText;
                btnLoginGoogle.disabled = false;
            }, 800); // 假裝等了 0.8 秒
        });

        btnLoginEmail.addEventListener('click', () => {
            alert('未來可在此處實作 Email 註冊/登入表單的彈出視窗。');
        });

        // 模擬登出流程
        btnLogout.addEventListener('click', () => {
            if(confirm('確定要登出嗎？')) {
                showUnauthView();
            }
        });

        /*
        // 💡 未來串接 Firebase 的真實寫法範例：
        // 假設您的 index.html 或全域腳本已經初始化了 firebase auth
        
        firebase.auth().onAuthStateChanged((user) => {
            if (user) {
                // 使用者已登入
                showAuthView({
                    name: user.displayName,
                    email: user.email,
                    photoURL: user.photoURL
                });
            } else {
                // 使用者未登入
                showUnauthView();
            }
        });
        */

    })();
</script>

<style>
    /* 簡易的淡入動畫，讓切換頁面時更順暢 */
    .animate-fade-in {
        animation: fadeIn 0.4s ease-out forwards;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
